<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Belle Berry — десерты ручной работы на заказ</title>
<meta name="description" content="Belle Berry — свежая малина в бельгийском шоколаде. Сделано для особенных моментов.">
<meta name="theme-color" content="#FFE8F0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>

  /* ============ TOKENS ============ */
  :root{
    --bg:        #FFE8F0;
    --bg-deep:   #FFD3E5;
    --accent:    #FF2F7E;
    --accent-dark:#DE0E63;
    --ink:       #3A1230;
    --ink-soft:  #7A4A63;
    --white:     #FFFFFF;
    --card:      #FFFBFC;

    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Inter', -apple-system, sans-serif;

    --radius-lg: 32px;
    --radius-md: 20px;
    --radius-full: 999px;

    --shadow-soft: 0 20px 60px -20px rgba(222, 14, 99, .28);
    --shadow-btn:  0 12px 28px -10px rgba(222, 14, 99, .35);

    --ease: cubic-bezier(.19,1,.22,1);
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
  }

  /* ============ RESET ============ */
  *,*::before,*::after{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; -webkit-text-size-adjust:100%; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:var(--font-body);
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img,svg{ display:block; max-width:100%; }
  a{ color:inherit; text-decoration:none; }
  h1,h2,h3,p{ margin:0; }
  button{ font:inherit; border:none; background:none; cursor:pointer; }

  :focus-visible{
    outline: 2px solid var(--accent-dark);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ============ DECOR LAYER ============ */
  .blob{
    position:absolute;
    border-radius:50%;
    filter: blur(2px);
    pointer-events:none;
  }
  .blob--1{ width:340px; height:340px; top:-120px; left:-110px; background:var(--bg-deep); opacity:.9; animation: float-a 16s ease-in-out infinite; }
  .blob--2{ width:220px; height:220px; top:8%; right:-90px; background:var(--white); opacity:.55; animation: float-b 14s ease-in-out infinite; }
  .blob--3{ width:160px; height:160px; bottom:6%; left:4%; background:var(--white); opacity:.4; animation: float-a 18s ease-in-out infinite reverse; }

  @keyframes float-a{
    0%,100%{ transform:translate(0,0) scale(1); }
    50%{ transform:translate(14px,-18px) scale(1.04); }
  }
  @keyframes float-b{
    0%,100%{ transform:translate(0,0) scale(1); }
    50%{ transform:translate(-16px,16px) scale(.97); }
  }

  .seed-field{
    position:absolute; inset:0;
    background-image: radial-gradient(var(--accent) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity:.05;
    pointer-events:none;
  }

  /* ============ HERO ============ */
  .hero{
    position:relative;
    min-height:100svh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding: 32px 24px 120px;
    overflow:hidden;
  }

  .hero-inner{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    align-items:center;
    max-width:520px;
  }

  .logo-mark{
    width:84px; height:84px;
    margin-bottom:28px;
    animation: rise .9s var(--ease) both;
  }

  .brand-name{
    font-family:var(--font-display);
    font-weight:500;
    color:var(--accent);
    font-size: clamp(2.6rem, 11vw, 4.6rem);
    letter-spacing:-0.01em;
    line-height:1;
    animation: rise .9s var(--ease) .08s both;
  }

  .slogan{
    margin-top:18px;
    font-family:var(--font-display);
    font-style:italic;
    font-weight:400;
    color:var(--ink-soft);
    font-size: clamp(1.05rem, 3.4vw, 1.35rem);
    animation: rise .9s var(--ease) .16s both;
  }

  .tags{
    margin-top:26px;
    display:flex;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    justify-content:center;
    font-family:var(--font-body);
    font-size:.68rem;
    font-weight:600;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--accent-dark);
    animation: rise .9s var(--ease) .24s both;
  }
  .tags span:not(.dot){ opacity:.85; }
  .dot{ width:3px; height:3px; border-radius:50%; background:var(--accent-dark); opacity:.5; }

  @keyframes rise{
    from{ opacity:0; transform:translateY(16px); }
    to{ opacity:1; transform:translateY(0); }
  }

  .scroll-cue{
    position:absolute;
    bottom:36px;
    left:50%;
    transform:translateX(-50%);
    z-index:2;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:6px;
    color:var(--accent-dark);
    opacity:.6;
    animation: bob 2.6s ease-in-out infinite;
  }
  .scroll-cue span{
    font-size:.62rem;
    letter-spacing:.16em;
    text-transform:uppercase;
    font-weight:600;
  }
  @keyframes bob{
    0%,100%{ transform:translate(-50%,0); }
    50%{ transform:translate(-50%,6px); }
  }

  /* ============ SHEET / CARD ============ */
  .sheet{
    position:relative;
    z-index:3;
    background:var(--card);
    border-radius: var(--radius-lg);
    margin: -84px 16px 0;
    box-shadow: var(--shadow-soft);
    padding: 56px 24px 8px;
  }

  @media (min-width:640px){
    .sheet{ margin:-84px auto 0; max-width:640px; padding:64px 48px 8px; }
  }

  .contact{
    text-align:center;
    padding-bottom:56px;
  }

  .contact h2{
    font-family:var(--font-display);
    font-weight:500;
    font-size: clamp(1.7rem, 5vw, 2.2rem);
    color:var(--ink);
  }

  .contact-sub{
    margin-top:12px;
    color:var(--ink-soft);
    font-size:.95rem;
    line-height:1.5;
    max-width:340px;
    margin-left:auto;
    margin-right:auto;
  }

  .contact-buttons{
    margin-top:40px;
    display:flex;
    justify-content:center;
    gap:22px;
    flex-wrap:wrap;
  }

  @media (min-width:480px){
    .contact-buttons{ gap:32px; }
  }

  .contact-btn{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:10px;
    width:96px;
  }

  .icon-circle{
    width:64px; height:64px;
    border-radius:50%;
    background:var(--white);
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow: var(--shadow-btn);
    transition: transform .35s var(--ease), background .35s var(--ease), box-shadow .35s var(--ease);
  }
  .icon-circle svg{ width:26px; height:26px; transition: fill .35s var(--ease); }

  @media (min-width:480px){
    .icon-circle{ width:72px; height:72px; }
    .icon-circle svg{ width:30px; height:30px; }
  }

  .contact-btn .label{
    font-size:.78rem;
    font-weight:600;
    color:var(--ink-soft);
    transition: color .35s var(--ease);
  }

  .contact-btn:hover .icon-circle,
  .contact-btn:focus-visible .icon-circle{
    transform: translateY(-4px) scale(1.05);
    background: var(--accent);
    box-shadow: 0 18px 32px -10px rgba(222,14,99,.5);
  }
  .contact-btn:hover .icon-circle svg,
  .contact-btn:focus-visible .icon-circle svg{ fill:var(--white); }
  .contact-btn:hover .label,
  .contact-btn:focus-visible .label{ color:var(--accent-dark); }
  .contact-btn:active .icon-circle{ transform: translateY(-1px) scale(.98); }

  .divider{
    width:40px; height:1px;
    background:var(--accent);
    opacity:.25;
    margin:0 auto 40px;
  }

  /* reveal-on-scroll */
  .reveal{ opacity:0; transform:translateY(18px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
  .reveal.is-visible{ opacity:1; transform:translateY(0); }

  /* ============ FOOTER ============ */
  footer{
    position:relative;
    z-index:2;
    text-align:center;
    padding: 40px 24px 44px;
    color:var(--accent-dark);
  }

  .footer-mark{ width:26px; height:26px; margin:0 auto 14px; opacity:.7; }

  footer p{
    font-size:.82rem;
    letter-spacing:.02em;
  }
  .copyright{ font-weight:600; }
  .made-with{ margin-top:4px; color:var(--ink-soft); font-weight:500; }

</style>
